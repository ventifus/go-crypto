      },
      "writtenOn": "2018-04-20T14:47:32Z",
      "side": 1,
      "message": "This can be combined to use a vector table lookup (VTBL) which is faster.",
      "range": {
        "startLine": 34,
        "startChar": 1,
        "endLine": 35,
        "endChar": 26
      },
      "revId": "c4148a71d969ed55fbbdb5cb3a5e5d4ebbadc256",
