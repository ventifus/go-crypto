      "writtenOn": "2022-03-14T23:07:12Z",
      "side": 1,
      "message": "minor nit: might want to check that we only accept one of these, otherwise the server could just keep sending them forever (extremely unlikely but ¯\\_(ツ)_/¯).",
      "revId": "d9f0775eae9a8536139992a522df96311d22da1b",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705"
    },
