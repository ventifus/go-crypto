      },
      "writtenOn": "2018-09-24T14:01:15Z",
      "side": 1,
      "message": "the standard has some language around returning the right error code. Does the library hadnle this for you, or does the implementor have to worry about it?",
      "range": {
        "startLine": 76,
        "startChar": 12,
        "endLine": 76,
        "endChar": 41
      },
      "revId": "ef52574fb427a2ffba1296a590479cfa4a9b462e",
