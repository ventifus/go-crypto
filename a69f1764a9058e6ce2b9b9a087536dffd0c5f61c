    },
    {
      "unresolved": true,
      "key": {
        "uuid": "ed12ae58_a2e9d535",
        "filename": "ssh/tcpip_test.go",
        "patchSetId": 2
      },
      "lineNbr": 65,
      "author": {
        "id": 5893
      },
      "writtenOn": "2023-10-11T13:55:47Z",
      "side": 1,
      "message": "The custom handler is running against the return of netPipe(), which means it doesn\u0027t run on port 22. You can never reach it by dialing the \"ssh\" service.\n\nCan you dial localhost:ssh directly to check if it runs SSH? You can login with pubkey auth and a \"doesnotexist\" uid, and check that you get an authentication error.\n\nIf there is no SSH running, this test has to be skipped.",
      "parentUuid": "b394f47e_ee291adb",
      "range": {
        "startLine": 65,
        "startChar": 41,
        "endLine": 65,
        "endChar": 63
      },
      "revId": "a69f1764a9058e6ce2b9b9a087536dffd0c5f61c",
