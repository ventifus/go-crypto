    {
      "key": {
        "uuid": "b3d82aa8_0ae86c48",
        "filename": "internal/chacha20/chacha_generic.go",
        "patchSetId": 7
      },
      "lineNbr": 105,
      "author": {
        "id": 11990
      },
      "writtenOn": "2018-04-26T22:50:11Z",
      "side": 1,
      "message": "It shaves about 10 instructions from the final assembly. There are quite a few (unnecessary. but hard for the compiler to figure out) bounds checks in this code and when re-slicing the compiler emits code to check both the length and the cap. By making them the same we get rid of the need to check the cap and, more importantly, reduce the register pressure a bit.",
      "parentUuid": "159fc5b3_bb486633",
      "revId": "5a2f10024a4fee2d2fcfddee755b3eea382a52b1",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705",
      "unresolved": false
    },
