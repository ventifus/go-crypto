      "message": "The reason I mention this is that we added a tested:\n\n```\ndiff --git a/ssh/handshake_test.go b/ssh/handshake_test.go\nindex b05aab3..6ded0ee 100644\n--- a/ssh/handshake_test.go\n+++ b/ssh/handshake_test.go\n@@ -22,6 +22,12 @@ type testChecker struct {\n \tcalls []string\n }\n \n+type parsedExtInfoMsg struct {\n+\tNumExtensions uint32 `sshtype:\"7\"`\n+\tExt           string\n+\tAlgs          []string\n+}\n+\n func (t *testChecker) Check(dialAddr string, addr net.Addr, key PublicKey) error {\n \tif dialAddr \u003d\u003d \"bad\" {\n \t\treturn fmt.Errorf(\"dialAddr is bad\")\n@@ -618,3 +624,52 @@ func TestNoSHA2Support(t *testing.T) {\n \t\tt.Fatal(err)\n \t}\n }\n+\n+func TestHandshakeExtInfoSignal(t *testing.T) {\n+\tclientConf :\u003d \u0026ClientConfig{\n+\t\tConfig:          Config{KeyExchanges: append(preferredKexAlgos, extInfoClient)},\n+\t\tHostKeyCallback: InsecureIgnoreHostKey(),\n+\t}\n+\ttrC, trS, err :\u003d handshakePair(clientConf, \"addr\", false)\n+\tif err !\u003d nil {\n+\t\tt.Fatalf(\"handshakePair: %v\", err)\n+\t}\n+\tdefer trC.Close()\n+\tdefer trS.Close()\n+\n+\tpacket, err :\u003d trC.readPacket()\n+\tif err !\u003d nil {\n+\t\tt.Fatalf(\"readPacket 1: %v\", err)\n+\t}\n+\n+\tvar extInfo parsedExtInfoMsg\n+\tif err :\u003d Unmarshal(packet, \u0026extInfo); err !\u003d nil {\n+\t\tt.Fatalf(\"unable to unmarshal packet: %v\", err)\n+\t}\n+\n+\tif extInfo.NumExtensions !\u003d 1 {\n+\t\tt.Errorf(\"expected 1 extension but received %d\", extInfo.NumExtensions)\n+\t}\n+\n+\tif extInfo.Ext !\u003d extServerSigAlgs {\n+\t\tt.Errorf(\"expected %s but received %s\", extServerSigAlgs, extInfo.Ext)\n+\t}\n+\n+\tif len(supportedServerSigAlgs) !\u003d len(extInfo.Algs) {\n+\t\tt.Errorf(\"expected %d %s but received %d\",\n+\t\t\tlen(supportedServerSigAlgs), extServerSigAlgs, len(extInfo.Algs))\n+\t}\n+\n+\tfor _, expected :\u003d range supportedServerSigAlgs {\n+\t\tfoundAlg :\u003d false\n+\t\tfor _, found :\u003d range extInfo.Algs {\n+\t\t\tif expected \u003d\u003d found {\n+\t\t\t\tfoundAlg \u003d true\n+\t\t\t\tbreak\n+\t\t\t}\n+\t\t}\n+\t\tif !foundAlg {\n+\t\t\tt.Errorf(\"could not find expected alg \u0027%s\u0027 in %s\", expected, extServerSigAlgs)\n+\t\t}\n+\t}\n+}\n```",
