    {
      "key": {
        "uuid": "b0b64787_4f6f6c5c",
        "filename": "poly1305/sum_noasm.go",
        "patchSetId": 1
      },
      "lineNbr": 5,
      "author": {
        "id": 11715
      },
      "writtenOn": "2020-02-07T17:36:53Z",
      "side": 0,
      "message": "The nacl GOOS is only supported on 386, amd64p32, and arm. None of those have an assembly implementation here, so nacl is implied by !amd64,!s390x,!ppc64le.",
      "parentUuid": "2d0ad294_1ba1d396",
      "range": {
