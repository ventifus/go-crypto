      "writtenOn": "2016-08-13T18:58:01Z",
      "side": 1,
      "message": "Why the loop? I\u0027m afraid this could get into a state where it loops forever.",
      "revId": "5a7a9287c3f5c7c6b80d4cadf78e815a6509d75e",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705",
