      },
      "writtenOn": "2015-04-27T23:40:24Z",
      "side": 1,
      "message": "Shouldn\u0027t the first four bytes be checked? I.e. extract the uint32 and use it?",
      "revId": "3d1897b2e360065eec7489836712ae27b75dad90",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705",
