      "writtenOn": "2018-01-11T21:52:42Z",
      "side": 1,
      "message": "GetCertificate uses a timeout of 5 minutes, yet it\u0027s one minute here. Any particular rationale here? Should they be the same? Maybe the timeout should be in a named constant.",
      "range": {
        "startLine": 253,
        "startChar": 49,
        "endLine": 253,
        "endChar": 59
      },
      "revId": "551128fb70f8c0164f8f757e040f88c949bd5b23",
