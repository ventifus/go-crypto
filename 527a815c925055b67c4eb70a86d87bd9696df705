    {
      "key": {
        "uuid": "c51b7613_b81c84fd",
        "filename": "acme/autocert/autocert.go",
        "patchSetId": 9
      },
      "lineNbr": 287,
      "author": {
        "id": 5065
      },
      "writtenOn": "2018-01-12T17:43:22Z",
      "side": 1,
      "message": "IndexByte if we really cared about performance, but this will be nowhere near noticeable in the grand scheme of this package \u0026 protocol exchange.\n\nSo right whatever\u0027s nicest to read. Don\u0027t worry about performance here. Index is shortest. And all 3 have fast paths for single ASCII bytes anyway.\n\nBut this should actually use https://golang.org/pkg/net/#SplitHostPort instead of manually looking for colons.\n\nI confirmed that browsers will send IPv6 literals with ports in the Host header:\n\nGET / HTTP/1.1\nHost: [2602:d1:xxxx::c60a]:1234\nConnection: keep-alive\nCache-Control: max-age\u003d0\nUser-Agent: Mozilla/5.0 (Macintosh; Intel Mac OS X 10_13_2) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/63.0.3239.132 Safari/537.36\nUpgrade-Insecure-Requests: 1\nAccept: text/html,application/xhtml+xml,application/xml;q\u003d0.9,image/webp,image/apng,*/*;q\u003d0.8\nAccept-Encoding: gzip, deflate\nAccept-Language: en-US,en;q\u003d0.9",
      "parentUuid": "53f35084_2cf74f7c",
      "revId": "527a815c925055b67c4eb70a86d87bd9696df705",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "6395feaf_6cf338e9",
        "filename": "acme/autocert/autocert.go",
        "patchSetId": 9
      },
      "lineNbr": 287,
      "author": {
        "id": 5065
      },
      "writtenOn": "2018-01-12T17:46:33Z",
      "side": 1,
      "message": "You can\u0027t use URL.Hostname for incoming requests. The Request.URL field is incomplete (lacks domain names) for incoming requests. The hostname will be blank.",
      "parentUuid": "c51b7613_b81c84fd",
      "revId": "527a815c925055b67c4eb70a86d87bd9696df705",
      "serverId": "62eb7196-b449-3ce5-99f1-c037f21e1705",
      "unresolved": true
    },
    {
      "key": {
        "uuid": "13aaacd7_317c59b1",
        "filename": "acme/autocert/autocert.go",
        "patchSetId": 9
